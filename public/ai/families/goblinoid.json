    ],
    "useAbility": [
      { "type": "targetHP", "curve": "inverse", "weight": 0.7 },
      { "type": "random", "weight": 0.3 }
    ],
    "moveTo": [{ "type": "distance", "curve": "inverse", "weight": 1.0 }]
