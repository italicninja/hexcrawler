        "name": "Flee if low HP",
        "children": [
          { "type": "Condition", "check": "hpBelow", "value": 0.25 },
          { "type": "Condition", "check": "notInBackline" },
          { "type": "Action", "action": "flee" }
        ]
      },
      {
        "type": "Sequence",
